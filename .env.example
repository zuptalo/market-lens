POSTGRES_PASSWORD=market_lens
POSTGRES_PORT=5432
APP_PORT=8080

# Generate a unique value with: openssl rand -base64 48. Signs sessions, CSRF tokens, emailed
# capabilities, and login codes; changing it signs everyone out.
AUTH_SECRET=
# Session and CSRF cookies use the __Host- prefix, which browsers accept only when the cookie
# is marked Secure. Leave this true everywhere: http://localhost counts as a secure origin, so
# local development works, while setting it to false makes sign-in silently impossible.
AUTH_SECURE_COOKIES=true
# Generate independently with: openssl rand -base64 32. Encrypts the EODHD and SMTP secrets
# entered in the setup wizard. Rotate only through `market-lens auth credential-key rotate`.
EXTERNAL_CREDENTIAL_KEY=
EXTERNAL_CREDENTIAL_KEY_VERSION=1
ALLOWED_ORIGINS=http://localhost:8080

# The owner password, the EODHD token, and the SMTP credential are never environment values.
# They are entered once in the setup wizard and stored encrypted, and nothing reads them back.
