PORT=8080
ENV=development
DATABASE_URL=postgres://market_lens:market_lens@localhost:5432/market_lens?sslmode=disable
ALLOWED_ORIGINS=http://localhost:5173

# Production image only: path containing the Vite build served by the Go process.
# STATIC_DIR=/app/web

# Account access
# --------------
# Keys the host supplies. Everything else an account needs — the owner's password, the EODHD
# token, and the SMTP credential — is entered once in the setup wizard and stored encrypted.
# There is no environment variable for any of them, and there is no way to read one back out.

# Optional. Leave empty and the application provisions its own signing key on first start and
# keeps it in the database, so a backup is a complete installation and a restore keeps every
# session working. Set it only if you want to supply your own; once set, it must keep being
# supplied, because removing it is reported rather than silently re-keying the installation.
AUTH_SECRET=
# Session and CSRF cookies use the __Host- prefix, which browsers accept only when the cookie
# is marked Secure. Leave this true everywhere: http://localhost counts as a secure origin, so
# local development works, while setting it to false makes sign-in silently impossible.
AUTH_SECURE_COOKIES=true
# Required before provider credentials can be stored. Generate with: openssl rand -base64 32.
# Encrypts the EODHD and SMTP secrets at rest. Unlike AUTH_SECRET this is never stored in the
# database, because it protects secrets held inside that same database - keep it with your
# backups, or those credentials become permanently unreadable. Rotate only through
# `market-lens auth credential-key rotate`, never by editing this alone.
EXTERNAL_CREDENTIAL_KEY=
EXTERNAL_CREDENTIAL_KEY_VERSION=1
# The absolute origin emailed links point at. Defaults to the first allowed origin.
# APP_BASE_URL=https://lens.example.com

# Optional lifetimes. The defaults are the reviewed ones; shortening them is safe, and
# lengthening them widens the window an unattended browser or a stolen link stays usable.
# AUTH_OWNER_IDLE_TIMEOUT=8h
# AUTH_SESSION_ABSOLUTE_TIMEOUT=720h
# AUTH_SETUP_TTL=15m
# AUTH_MEMBER_CODE_TTL=10m
# AUTH_MEMBER_TEMP_BLOCK=15m

# EOD Historical Data is used only by host commands and the optional in-process daily
# schedule. The account-facing EODHD key is the one entered in the setup wizard instead.
MARKET_DATA_PROVIDER=eodhd
EODHD_API_TOKEN=
MARKET_DATA_SCHEDULE_ENABLED=false
MARKET_DATA_DAILY_TIME=20:00
MARKET_DATA_DAILY_TIMEZONE=Europe/Stockholm
MARKET_DATA_REQUEST_TIMEOUT=30s
MARKET_DATA_MAX_RETRIES=3
MARKET_DATA_WORKERS=4
